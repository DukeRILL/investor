        "inputDataFieldName": "data"
      }
    },
    {
      "id": "v11",
      "name": "Ролики",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ],
      "parameters": {
        "jsCode": "const d = $('Сценарии и каталог фото').first().json;\nreturn d.scenarios.map((sc, s) => ({ job: d.job, s, ok: !sc.problems.length })).filter(x => x.ok).map(x => ({ json: x }));"
      },
      "executeOnce": true
    },
    {
      "id": "v12",
      "name": "Рендер (FFmpeg)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        0
