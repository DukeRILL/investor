        "url": "={{ 'http://video-ffmpeg:8020/jobs/' + $json.job + '/' + $json.s + '/stock/' + $json.image_id }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({prompt: $json.image_prompt}) }}",
        "options": {
