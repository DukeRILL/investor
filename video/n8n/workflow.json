      "parameters": {
        "jsCode": "const d = $('Сценарии и каталог фото').first().json;\nreturn [{ json: { job: d.job, title: d.title, deepseek_calls: d.deepseek_calls, best: d.best, best_why: d.best_why, flux_calls: d.generate.length,\n  videos: $input.all().map(i => i.json), catalog: d.catalog.map(c => ({ id: c.id, kind: c.kind, priority: c.priority, available: c.available, source_url: c.source_url })) } }];"
      }
    },
