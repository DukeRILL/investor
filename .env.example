# Copy to .env on the server and fill in. Never commit .env.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@investor_duker
# Your personal Telegram numeric id: failures and the daily cost report go here, never to the channel.
TELEGRAM_ADMIN_CHAT_ID=
# auto = post straight to the channel; draft = send everything to the admin chat instead
PUBLISH_MODE=auto

FRED_API_KEY=
DATABASE_PATH=data/investor.sqlite3
SCHEDULER_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional VK publishing through Postmypost v4.1. Keep disabled until the
# project and VK account IDs have been verified in Postmypost.
POSTMYPOST_ENABLED=0
POSTMYPOST_API_TOKEN=
POSTMYPOST_PROJECT_ID=
POSTMYPOST_VK_ACCOUNT_ID=
# Soft alert to the admin at this DeepSeek spend per Beijing day; calls stop at twice this. 0 = off.
DAILY_BUDGET_USD=3.0
