# Copy to .env on the server and fill in. Never commit .env.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@investor_duker
# Your personal Telegram numeric id: failures and the daily cost report go here, never to the channel.
TELEGRAM_ADMIN_CHAT_ID=
# auto = post straight to the channel; draft = send everything to the admin chat instead
PUBLISH_MODE=auto

FRED_API_KEY=
DATABASE_PATH=data/investor.sqlite3
SCHEDULER_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
