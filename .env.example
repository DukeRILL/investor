# Copy to .env on the server and fill in. Never commit .env.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@investor_duker
# Your personal Telegram numeric id: failures and the daily cost report go here, never to the channel.
TELEGRAM_ADMIN_CHAT_ID=
# auto = post straight to the channel; draft = send everything to the admin chat instead
PUBLISH_MODE=auto

FRED_API_KEY=
DATABASE_PATH=data/investor.sqlite3
SCHEDULER_ENABLED=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Soft alert to the admin at this DeepSeek spend per Beijing day; calls stop at twice this. 0 = off.
DAILY_BUDGET_USD=3.0

# Growth statistics (docs/GROWTH.md). OFF unless 1.
GROWTH_ENABLED=
# 1 only behind your own reverse proxy that sets X-Forwarded-For
TRUST_PROXY=
# Public HTTPS origin of this app (e.g. https://go.example.com). Only needed to count clicks via /go/<code>.
PUBLIC_BASE_URL=
# TGStat STAT API (FREE: 50 requests/month, 2 own channels). Token only on the server.
TGSTAT_API_TOKEN=
TGSTAT_CHANNEL_ID=
TGSTAT_MONTHLY_LIMIT=
TGSTAT_RESERVE=
TGSTAT_ACCESS_UNTIL=
